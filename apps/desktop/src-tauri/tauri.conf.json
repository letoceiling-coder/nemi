{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Фокус",
  "version": "0.1.0",
  "identifier": "ru.siteaccess.focus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Фокус", "width": 1360, "height": 860, "minWidth": 1000, "minHeight": 640, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://127.0.0.1:8731 http://localhost:8731 ws://localhost:5173; frame-src https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"] } }
  }
}
